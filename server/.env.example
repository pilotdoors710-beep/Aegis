# Copy to .env — never commit .env.
CORS_ORIGINS=http://localhost:3000
FAIL_MODE=closed
MAX_CONCURRENT_RUNS=1

# LLM providers (free tiers). Ordered fallback chain: first entry is tried first.
# Look up current model IDs in each provider console; do not guess them.
# Example: AGENT_MODELS=gemini:<flash-lite-id>,groq:<70b-id>,openrouter:<id>:free
# Verify with: uv run python -m aegis.llm
AGENT_MODELS=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
# Max requests/minute we send each provider (keep under its free-tier cap).
GEMINI_RPM=4
GROQ_RPM=20
OPENROUTER_RPM=15
CEREBRAS_RPM=20

# Supabase (server-side only)
SUPABASE_DB_URL=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
